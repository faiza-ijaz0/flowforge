# Copy to .env and fill in real values for local development.
# NEVER commit a real .env file -- it is git-ignored on purpose.

# --- Application ---
# development | test | staging | production
FLOWFORGE_ENV=development

# --- API server ---
FLOWFORGE_SERVER_HOST=0.0.0.0
FLOWFORGE_SERVER_PORT=8080

# --- Database ---
# Required outside development/test. Format: postgres://user:password@host:port/dbname
# When unset (development/test only), FlowForge uses in-memory repositories
# instead -- see docs/architecture/overview.md, "PostgreSQL persistence".
FLOWFORGE_DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge
# Size of the PostgreSQL connection pool. Only meaningful when
# FLOWFORGE_DATABASE_URL is set.
FLOWFORGE_DB_POOL_SIZE=8

# --- Engine ---
FLOWFORGE_WORKER_COUNT=4
FLOWFORGE_QUEUE_CAPACITY=1024

# --- Scheduler (Phase 2B-2) ---
# Bounded capacity of the in-memory priority dispatch queue. schedule()
# returns ErrorCode::Conflict once this many jobs are queued and undispatched.
FLOWFORGE_SCHEDULER_QUEUE_CAPACITY=1024
# Number of background dispatch threads draining the priority queue.
FLOWFORGE_SCHEDULER_DISPATCH_WORKERS=2

# --- Worker pool / execution (Phase 2B-3) ---
# Number of local worker threads that actually execute jobs.
FLOWFORGE_WORKER_POOL_SIZE=4
# Bounded capacity of the worker pool's own dispatch queue.
FLOWFORGE_WORKER_POOL_QUEUE_CAPACITY=1024
# Cooperative per-attempt execution timeout, in milliseconds.
FLOWFORGE_EXECUTION_TIMEOUT_MS=60000

# --- CORS (browser dashboard support) ---
# Browser origin allowed to make cross-origin requests to this API. Exact
# match only, never a wildcard. Empty disables CORS headers entirely.
FLOWFORGE_CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Retry dispatcher (Phase 2B-4) ---
# How often the retry dispatcher re-scans for Retrying jobs whose backoff
# has elapsed, in milliseconds.
FLOWFORGE_RETRY_POLL_INTERVAL_MS=500
# Maximum Retrying jobs re-submitted per poll tick.
FLOWFORGE_RETRY_BATCH_SIZE=50

# --- OCR (image processing) ---
# Optional absolute path to the tesseract CLI. When unset the server probes
# PATH and the standard install locations; if none is found it still starts,
# but image/OCR processing reports OCR as unavailable.
# FLOWFORGE_TESSERACT_PATH=/usr/bin/tesseract

# --- Logging ---
# trace | debug | info | warn | error | critical | off
FLOWFORGE_LOG_LEVEL=info
# true = one JSON object per log line (production-friendly);
# false = human-readable colorized line (development-friendly)
FLOWFORGE_STRUCTURED_LOGGING=false

# --- Dashboard (apps/dashboard) ---
# Inlined into the browser bundle at *build* time (next build / docker build),
# not read at runtime. Must be the API URL as reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- docker-compose only: local PostgreSQL container credentials ---
# These seed the postgres:16 image on first run. Change them for anything
# beyond local development; they are not used by the server directly
# (the server reads FLOWFORGE_DATABASE_URL above).
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_DB=flowforge
