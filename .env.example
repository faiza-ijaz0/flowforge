# Copy to .env and fill in real values for local development.
# NEVER commit a real .env file -- it is git-ignored on purpose.

# --- Application ---
# development | test | staging | production
FLOWFORGE_ENV=development

# --- API server ---
FLOWFORGE_SERVER_HOST=0.0.0.0
FLOWFORGE_SERVER_PORT=8080

# --- Database ---
# Required outside development/test. Format: postgres://user:password@host:port/dbname
FLOWFORGE_DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge

# --- Engine ---
FLOWFORGE_WORKER_COUNT=4
FLOWFORGE_QUEUE_CAPACITY=1024

# --- Logging ---
# trace | debug | info | warn | error | critical | off
FLOWFORGE_LOG_LEVEL=info
# true = one JSON object per log line (production-friendly);
# false = human-readable colorized line (development-friendly)
FLOWFORGE_STRUCTURED_LOGGING=false

# --- Dashboard (apps/dashboard) ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- docker-compose only: local PostgreSQL container credentials ---
# These seed the postgres:16 image on first run. Change them for anything
# beyond local development; they are not used by the server directly
# (the server reads FLOWFORGE_DATABASE_URL above).
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_DB=flowforge
