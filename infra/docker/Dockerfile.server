# Multi-stage build for the FlowForge C++ API server.
#
# Builder stage compiles with clang + Ninja (matching local development --
# see docs/development for why clang was chosen) and fetches third-party
# dependencies via CMake FetchContent at build time, so this image needs
# network access during `docker build` (not at runtime). The final image
# contains only the built binary and its runtime shared-library
# dependencies, not a compiler toolchain. The runtime image also carries
# the Tesseract CLI, which image/OCR processing invokes as a subprocess
# (engine/src/providers/tesseract_ocr_provider.cpp discovers
# /usr/bin/tesseract); without it the server starts but image processing
# reports OCR as unavailable.

FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang \
        cmake \
        ninja-build \
        git \
        ca-certificates \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt .
COPY cmake ./cmake
COPY engine ./engine
COPY apps/server ./apps/server
COPY benchmarks ./benchmarks

RUN cmake -B build -G Ninja \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_BUILD_TYPE=Release \
        -DFLOWFORGE_BUILD_TESTS=OFF \
        -DFLOWFORGE_BUILD_BENCHMARKS=OFF \
    && cmake --build build --target flowforge_server -j

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libpq5 \
        tesseract-ocr \
        tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --shell /usr/sbin/nologin flowforge

COPY --from=builder /src/build/apps/server/flowforge_server /usr/local/bin/flowforge_server

USER flowforge
EXPOSE 8080

# Hits the same GET /ready the dashboard's System health page polls (see
# apps/server/src/http/routes/health_routes.cpp) -- a real readiness check
# (database/scheduler/worker_pool/retry_dispatcher), not just "is the
# listener up". start-period gives the process time to connect to
# PostgreSQL and start the scheduler/worker pool before failures count.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/ready || exit 1

ENTRYPOINT ["/usr/local/bin/flowforge_server"]
